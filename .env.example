# Hyperliquid Configuration
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_TESTNET=true
HYPERLIQUID_RPC_URL=

# Trading Configuration
MAX_POSITION_SIZE=1000
MAX_LEVERAGE=10
DEFAULT_LEVERAGE=3
